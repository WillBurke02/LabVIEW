<UserControl
    x:Class="TimetTankSix.Controls.VerticalGauge" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TimetTankSix.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="400" d:DesignWidth="100" mc:Ignorable="d">
    <Grid HorizontalAlignment="Center" ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="1" Grid.Column="0" Width="Auto"
            Margin="{StaticResource AllExtraLarge}"
            Background="{StaticResource White}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="{StaticResource AllExtraSmall}"
            ClipToBounds="False" CornerRadius="2">
            <Grid ClipToBounds="False">
                <!--  Place colored bar behind the scale  -->
                <Canvas
                    x:Name="BarCanvas" Panel.ZIndex="0" ClipToBounds="False">
                    <!--  Colored bar goes here  -->
                </Canvas>

                <!--  Value indicator (gauge fill) placed on top  -->
                <Rectangle
                    x:Name="ValueBar" Width="20"
                    Height="{Binding BarHeight, RelativeSource={RelativeSource AncestorType=local:VerticalGauge}}"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="1"
                    Fill="{Binding GaugeColor, RelativeSource={RelativeSource AncestorType=local:VerticalGauge}}"
                    Opacity="0.3">
                    <Rectangle.RenderTransform>
                        <TranslateTransform Y="{Binding BarTop, RelativeSource={RelativeSource AncestorType=local:VerticalGauge}}" />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!--  Scale and ticks above value bar  -->
                <Canvas
                    x:Name="TickCanvas" Panel.ZIndex="3" ClipToBounds="False">
                    <!--  Ticks and scale markings  -->
                </Canvas>

                <!--  Current value indicator  -->
                <Rectangle
                    Width="30" Height="2" HorizontalAlignment="Center"
                    VerticalAlignment="Top" Panel.ZIndex="4"
                    Fill="{StaticResource RedButtonColour}"
                    Opacity="0.5">
                    <Rectangle.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.Y>
                                <MultiBinding Converter="{StaticResource ValueToPositionConverter}">
                                    <Binding Path="NormalizedValue" RelativeSource="{RelativeSource AncestorType=local:VerticalGauge}" />
                                    <Binding ElementName="TickCanvas" Path="ActualHeight" />
                                </MultiBinding>
                            </TranslateTransform.Y>
                        </TranslateTransform>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!--  Position the threshold rectangle at the correct position  -->
            </Grid>
        </Border>

        <!--  Spacer column for tick labels  -->
        <Canvas
            Grid.Row="1" Grid.Column="1" Width="16"
            ClipToBounds="False" />
    </Grid>
</UserControl>
