<UserControl
    x:Class="TimetTankSix.Controls.HorizontalGauge" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TimetTankSix.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450" d:DesignWidth="800" mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Left value label  -->
        <TextBlock
            Grid.Column="0" VerticalAlignment="Center"
            FontSize="{StaticResource ExtraSmallFont}"
            Text="{Binding MinValue, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}, StringFormat='{}{0:F1}'}"
            Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!--  Main gauge area  -->
        <Border
            Grid.Column="1"
            Margin="{StaticResource AllExtraLarge}"
            Background="{StaticResource PromptColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="{StaticResource AllExtraSmall}"
            CornerRadius="3">
            <Grid>
                <!--  Gauge track  -->
                <Rectangle
                    Height="20" VerticalAlignment="Center"
                    Fill="{StaticResource PanelBackgroundColour}" />

                <!--  Value Bar Canvas - Moved BELOW tick canvas in z-order  -->
                <Canvas
                    x:Name="ValueBarCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Panel.ZIndex="0">
                    <!--  Value indicator with CORRECTED opacity  -->
                    <Rectangle
                        x:Name="ValueBar" Height="20" VerticalAlignment="Center"
                        Fill="{Binding GaugeColor, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}}"
                        Opacity="0.3" />
                </Canvas>

                <!--  Center line marker  -->
                <Line
                    x:Name="CenterLine" VerticalAlignment="Stretch" Panel.ZIndex="1"
                    Stroke="Black" StrokeDashArray="4,2" StrokeThickness="1" />

                <!--  Tick marks canvas ABOVE value bar  -->
                <Canvas
                    x:Name="TickCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Panel.ZIndex="3" />

                <!--  Current value indicator (vertical marker)  -->
                <Rectangle
                    Width="2" Height="30" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Panel.ZIndex="4"
                    Fill="{StaticResource RedButtonColour}"
                    Opacity="0.8">
                    <Rectangle.RenderTransform>
                        <TranslateTransform>
                            <TranslateTransform.X>
                                <MultiBinding Converter="{StaticResource ValueToPositionConverter}">
                                    <Binding Path="NormalizedValue" RelativeSource="{RelativeSource AncestorType=local:HorizontalGauge}" />
                                    <Binding ElementName="TickCanvas" Path="ActualWidth" />
                                </MultiBinding>
                            </TranslateTransform.X>
                        </TranslateTransform>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!--  Threshold indicator  -->

                <!--  Current value display  -->
            </Grid>
        </Border>

        <!--  Right label with max value and unit  -->
        <StackPanel
            Grid.Column="2" Margin="5,0,8,0" VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                FontSize="{StaticResource ExtraSmallFont}"
                Text="{Binding MaxValue, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}, StringFormat='{}{0:F1}'}"
                Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                FontSize="{StaticResource ExtraSmallFont}"
                Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}}"
                Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=local:HorizontalGauge}, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
