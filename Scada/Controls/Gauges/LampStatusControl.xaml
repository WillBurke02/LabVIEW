<UserControl
    x:Class="TimetTankSix.Controls.LampStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimetTankSix.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="{Binding Height, FallbackValue=55}"
    d:DesignWidth="{Binding Width, FallbackValue=130}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="{Binding Background, FallbackValue=MintCream}" />
        </Grid.Background>
        <Label Content="{Binding LabelText, FallbackValue=Label}">

            <Label.HorizontalAlignment>
                <Binding FallbackValue="Left" Path="LabelPosition" />
            </Label.HorizontalAlignment>
            <Label.VerticalAlignment>
                <Binding FallbackValue="Center" Path="LabelVerticalAlignment" />
            </Label.VerticalAlignment>
            <Label.FontSize>
                <Binding FallbackValue="18" Path="LabelFontSize" />
            </Label.FontSize>
        </Label>
        <Grid Margin="0,0,10,0" HorizontalAlignment="Right">
            <Border>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{Binding BorderColour, FallbackValue=Black}" />
                </Border.BorderBrush>
                <Border.Background>
                    <SolidColorBrush Color="{Binding State, FallbackValue=Crimson}" />
                </Border.Background>
                <Border.VerticalAlignment>
                    <Binding FallbackValue="Center" Path="LampVerticalAlignment" />
                </Border.VerticalAlignment>
                <Border.Width>
                    <Binding FallbackValue="50" Path="GridWidth" />
                </Border.Width>
                <Border.Height>
                    <Binding FallbackValue="50" Path="GridHeight" />
                </Border.Height>
                <Border.CornerRadius>
                    <Binding FallbackValue="360" Path="Shape" />
                </Border.CornerRadius>
            </Border>
        </Grid>
    </Grid>
</UserControl>
