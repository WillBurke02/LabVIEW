<UserControl
    x:Class="TimetTankSix.Controls.PasswordUserBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimetTankSix.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <PasswordBox
            x:Name="PasswordTextBox"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="{StaticResource InputEnabledColor}"
            FontFamily="Segoe"
            FontSize="{StaticResource MediumFont}"
            Foreground="{StaticResource PrimaryTextColor}"
            PasswordChanged="PasswordTextBox_PasswordChanged" />
        <TextBox
            x:Name="ShowPasswordTextBox"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="{StaticResource InputEnabledColor}"
            FontFamily="Segoe"
            FontSize="{StaticResource MediumFont}"
            Foreground="{StaticResource PrimaryTextColor}"
            TextChanged="ShowPasswordTextBox_TextChanged"
            Visibility="Collapsed" />
        <ToggleButton
            x:Name="ShowPasswordButton"
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Center"
            Background="Transparent"
            BorderBrush="Transparent"
            Checked="ShowPasswordBtn_OnClick"
            Foreground="Transparent"
            Unchecked="ShowPasswordBtn_OnClick"
            UseLayoutRounding="True">
            <TextBlock
                x:Name="ShowPasswordIcon"
                FontFamily="Segoe Fluent Icons"
                FontSize="{StaticResource TitleFont}"
                Foreground="{StaticResource PrimaryTextColor}"
                Opacity="0.6"
                Text="&#xE9A9;" />
        </ToggleButton>
    </Grid>
</UserControl>
