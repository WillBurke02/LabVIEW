<UserControl
    x:Class="TimetTankSix.Controls.NumericInputTextBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TimetTankSix.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450" d:DesignWidth="800" mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="NumericTextBox"
            Style="{StaticResource AccountInputBoxStyle}"
            Text="{Binding Value}" />
        <TextBlock
            x:Name="UnitTextBlock" Grid.Column="1" Margin="5,0,0,0"
            Text="{Binding Unit}" />
    </Grid>
</UserControl>
