<Window
    x:Class="TimetTankSix.Windows.LogInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimetTankSix.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimetTankSix.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Log In"
    Width="300"
    Height="200"
    mc:Ignorable="d">
    <Border Style="{StaticResource PromptStyle}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Label Content="&#xE77B;" Style="{StaticResource IconLabelStyle}" />
                <TextBox
                    x:Name="UsernameTextBox"
                    Grid.Column="1"
                    GotFocus="TextBoxFocus"
                    KeyDown="PasswordTextBox_KeyDown"
                    KeyUp="PasswordTextBox_KeyDown"
                    Style="{StaticResource AccountInputBoxStyle}" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <Label Content="&#xE72E;" Style="{StaticResource IconLabelStyle}" />
                <controls:PasswordUserBox
                    x:Name="PasswordTextBox"
                    Grid.Column="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    GotFocus="TextBoxFocus"
                    KeyDown="PasswordTextBox_KeyDown"
                    KeyUp="PasswordTextBox_KeyDown"
                    Style="{StaticResource PasswordBoxStyle}" />

            </Grid>
            <Button
                x:Name="LogInButton"
                Width="100"
                Height="30"
                Margin="2,2,2,2"
                Click="LogInBtn_OnClick"
                Content="Log In"
                Style="{StaticResource DefaultButtonStyle}" />
            <Label
                x:Name="StatusLabel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                Content="Username or password are incorrect."
                FontSize="{StaticResource SmallFont}"
                Foreground="{StaticResource TabColor}" />
        </StackPanel>
    </Border>
</Window>