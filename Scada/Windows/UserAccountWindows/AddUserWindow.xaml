<Window
    x:Class="TimetTankSix.Windows.AddUserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TimetTankSix.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TimetTankSix.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add User"
    Width="450"
    Height="250"
    mc:Ignorable="d">
    <Border Style="{StaticResource PromptStyle}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  Username Box  -->
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource AccountLabelStyle}"
                Text="Username:" />
            <TextBox
                x:Name="UsernameTextBox"
                Grid.Column="1"
                Style="{StaticResource AccountInputBoxStyle}" />
            <!--  Password Box  -->
            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource AccountLabelStyle}"
                Text="Password:" />
            <controls:PasswordUserBox
                x:Name="PasswordTextBox"
                Grid.Row="1"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Style="{StaticResource PasswordBoxStyle}" />
            <!--  Confirm Password Box  -->
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource AccountLabelStyle}"
                Text="Confirm Password:" />
            <controls:PasswordUserBox
                x:Name="ConfirmPasswordTextBox"
                Grid.Row="2"
                Grid.Column="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Style="{StaticResource PasswordBoxStyle}" />
            <!--  First Name Box  -->
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Style="{StaticResource AccountLabelStyle}"
                Text="First Name:" />
            <TextBox
                x:Name="FirstNameTextBox"
                Grid.Row="3"
                Grid.Column="1"
                Style="{StaticResource AccountInputBoxStyle}" />
            <!--  Last Name Box  -->
            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Style="{StaticResource AccountLabelStyle}"
                Text="Last Name:" />
            <TextBox
                x:Name="LastNameTextBox"
                Grid.Row="4"
                Grid.Column="1"
                Style="{StaticResource AccountInputBoxStyle}" />
            <!--  Admin / Add Btn  -->
            <Grid Grid.Row="5" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton
                    x:Name="AdminToggleBtn"
                    Grid.Column="0"
                    Margin="{StaticResource AllLarge}"
                    Content="Admin"
                    Style="{StaticResource DefaultToggleButtonStyle}" />
                <Button
                    x:Name="AddUserBtn"
                    Grid.Column="1"
                    Margin="{StaticResource AllLarge}"
                    Click="AddUserBtn_OnClick"
                    Content="Add User"
                    Style="{StaticResource DefaultButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>