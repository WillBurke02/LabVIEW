<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TimetTankSix.Controls">
    <!--#region Combo Box-->
    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="{StaticResource AllMedium}" />
    </Style>
    <!--#endregion-->
    <!--#region Flyout Menu-->
    <Style x:Key="FlyoutMenuStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PageColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllSmall}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="FlyoutMenuItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource NavigationBorderColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource EnabledColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InputDisabledTextColor}" />
                            <Setter Property="Background" Value="{StaticResource NavigationDisabledColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->
    <!--#region Slider-->
    <Style x:Key="SliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource DataTextColor}" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Background" Value="{StaticResource PanelBackgroundColour}" />
        <Setter Property="TickPlacement" Value="BottomRight" />
        <Setter Property="TickFrequency" Value="10" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="SmallChange" Value="5" />
        <Setter Property="LargeChange" Value="10" />
    </Style>
    <!--#endregion-->
    <!--#region Gauges-->
    <Style x:Key="VerticalGaugeStyle" TargetType="controls:VerticalGauge">
        <Setter Property="ShowLabels" Value="True" />
        <Setter Property="GaugeColor" Value="{StaticResource GaugeColor}" />
        <Setter Property="HighColor" Value="{StaticResource GaugeHighColor}" />
        <Setter Property="LowColor" Value="{StaticResource GaugeLowColor}" />
        <Setter Property="ThresholdColor" Value="{StaticResource GaugeThresholdColor}" />
        <Setter Property="Margin" Value="{StaticResource AllExtraLarge}" />
        <Setter Property="Height" Value="450" />
    </Style>
</ResourceDictionary>