<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TimetTankSix.Controls">
    <!--#region  Icons-->
    <Style x:Key="IconLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="{StaticResource LargeFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="{StaticResource AllMedium}" />
    </Style>
    <Style x:Key="IconTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="{StaticResource IconFontSize}" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
    </Style>
    <!--#endregion-->
    <!--#region  Accounts Window Styling-->
    <Style x:Key="AccountInputBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource InputEnabledColor}" />
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <Style x:Key="AccountLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <Style x:Key="PasswordBoxStyle" TargetType="controls:PasswordUserBox">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource InputEnabledColor}" />
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <!--#endregion-->
    <!--#region  General Styling (Title/Header/Sub)-->
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <Style x:Key="HeaderLabelStyle" TargetType="Label">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource ExtraLargeFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="{StaticResource AllMedium}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{StaticResource LargeFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="{StaticResource AllMedium}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <Style x:Key="SubSubHeadTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="FontSize" Value="{StaticResource ExtraSmallFont}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <!--#endregion-->
    <!--#region Misc-->
    <Style x:Key="InformationStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextColor}" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <!--#endregion-->
    <!--#region Menu Bar-->
    <Style x:Key="BottomMenuLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource MediumFont}" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource TopMenuColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource MenuBorderColor}" />
        <Setter Property="FontFamily" Value="Segoe" />
    </Style>
    <!--#endregion-->
    <!--#region Data Display-->
    <Style x:Key="DataTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="{StaticResource LargeFont}" />
        <Setter Property="Foreground" Value="{StaticResource DataTextColor}" />
        <Setter Property="Margin" Value="{StaticResource AllSmall}" />
        <Setter Property="FontFamily" Value="Segoe" />
        <Setter Property="Background" Value="{StaticResource InputDisabledColor}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="{StaticResource AllSmall}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!--#endregion-->
</ResourceDictionary>