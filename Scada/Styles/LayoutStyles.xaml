<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--#region Menu-->
    <Style x:Key="MenuBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource MenuBorderColor}" />
    </Style>
    <!--#endregion-->
    <!--#region  Prompts / Pop-ups-->
    <Style x:Key="PromptStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PromptColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllSmall}" />
    </Style>
    <!--#endregion-->
    <!--#region Page-->
    <Style x:Key="PageStyle" TargetType="Page">
        <Setter Property="Background" Value="{StaticResource PageColor}" />
    </Style>
    <Style x:Key="PageBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllSmall}" />
    </Style>
    <!--#endregion-->
    <!--#region Core Page Components-->
    <Style x:Key="SeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="{StaticResource TopBottomSmall}" />
        <Setter Property="Background" Value="{StaticResource BorderColor}" />
        <Setter Property="Height" Value="2" />
    </Style>
    <Style x:Key="TabStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TabColor}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllSmall}" />
        <Setter Property="Margin" Value="{StaticResource AllMedium}" />
    </Style>
    <Style x:Key="SubTabStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackgroundColour}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
        <Setter Property="BorderThickness" Value="{StaticResource AllSmall}" />
        <Setter Property="Margin" Value="{StaticResource AllMedium}" />
    </Style>
    <!--#endregion-->
</ResourceDictionary>