<Window
    x:Class="TimetTankSix.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:TimetTankSix" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Height="1080" d:Width="1920" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="56*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <!--#region Top Menu Bar-->
        <Border
            Grid.Row="0"
            Background="{StaticResource TopMenuColor}"
            BorderThickness="{StaticResource AllSmall}"
            Style="{StaticResource MenuBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="AccountBtn" Grid.Column="0" Click="AccountBtn_OnClick"
                    Content="&#xEC19;"
                    Style="{StaticResource DefaultIconButtonStyle}" />
                <Popup
                    x:Name="AccountPopup" Grid.Column="0" AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=AccountBtn}"
                    PopupAnimation="Slide" StaysOpen="False">
                    <Border MinWidth="200" Style="{StaticResource FlyoutMenuStyle}">
                        <StackPanel>
                            <Button
                                x:Name="LoginMenuItem" Click="LoginMenuItem_OnClick"
                                Style="{StaticResource FlyoutMenuItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,10,0" FontFamily="Segoe Fluent Icons" Text="&#xE77B;" />
                                    <TextBlock FontFamily="Segoe" Text="Login" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="LogoutMenuItem" Click="LogoutMenuItem_OnClick"
                                Style="{StaticResource FlyoutMenuItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,10,0" FontFamily="Segoe Fluent Icons" Text="&#xF3B1;" />
                                    <TextBlock FontFamily="Segoe" Text="Logout" />
                                </StackPanel>
                            </Button>
                            <Separator
                                x:Name="LogoutSeparator" Margin="8,4"
                                Background="{StaticResource BorderColor}" />
                            <Button
                                x:Name="ManageUsersMenuItem" Click="ManageUsersMenuItem_OnClick"
                                Style="{StaticResource FlyoutMenuItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,10,0" FontFamily="Segoe Fluent Icons" Text="&#xE716;" />
                                    <TextBlock FontFamily="Segoe" Text="Manage Users" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBlock
                    x:Name="CurrentUserText" Grid.Column="1" Grid.ColumnSpan="2"
                    Margin="{StaticResource SideSmall}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontSize="{StaticResource MediumFont}"
                    Foreground="{StaticResource InputEnabledColor}"
                    Text="Not logged in." TextWrapping="Wrap" />
                <Grid Grid.Column="3">
                    <Button
                        x:Name="AlarmButton" Content="&#xF2A3;"
                        Style="{StaticResource DefaultIconButtonStyle}" />
                    <Border
                        x:Name="AlarmBadge" Height="16" MinWidth="16"
                        Margin="0,-26,-16,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource UrgentAlarmColor}"
                        CornerRadius="8">
                        <TextBlock
                            x:Name="AlarmCountText" HorizontalAlignment="Center" VerticalAlignment="Center"
                            FontSize="10" FontWeight="Bold"
                            Foreground="{StaticResource UrgentAlarmTextColor}"
                            Text="0" />
                    </Border>
                </Grid>
                <Button
                    x:Name="StatusBtn" Grid.Column="4" Content="&#xE946;"
                    Style="{StaticResource DefaultIconButtonStyle}" />
                <Button
                    x:Name="SettingsBtn" Grid.Column="23" Content="&#xE713;"
                    Style="{StaticResource DefaultIconButtonStyle}" />
            </Grid>
        </Border>
        <!--#endregion-->
        <!--#region Tab Navigation-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="StartNavButton" Grid.Column="0" Click="TabNavigationBtn_OnClick"
                Content="Start"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="0" />
            <Button
                x:Name="InformationNavButton" Grid.Column="1" Click="TabNavigationBtn_OnClick"
                Content="Information &amp; Setup"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="1" />
            <Button
                x:Name="ChannelNavButton" Grid.Column="2" Click="TabNavigationBtn_OnClick"
                Content="Channel Setup"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="2" />
            <Button
                x:Name="BeamNavButton" Grid.Column="3" Click="TabNavigationBtn_OnClick"
                Content="Beam Width"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="3" />
            <Button
                x:Name="ScanNavButton" Grid.Column="4" Click="TabNavigationBtn_OnClick"
                Content="C-Scan"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="4" />
            <Button
                x:Name="ResultsNavButton" Grid.Column="5" Click="TabNavigationBtn_OnClick"
                Content="Analysis Results"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="5" />
            <Button
                x:Name="SNRNavButton" Grid.Column="6" Click="TabNavigationBtn_OnClick"
                Content="Auto SNR Analysis"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="6" />
            <Button
                x:Name="HeatNavButton" Grid.Column="7" Click="TabNavigationBtn_OnClick"
                Content="Heat Details"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="7" />
            <Button
                x:Name="ReportingNavButton" Grid.Column="8" Click="TabNavigationBtn_OnClick"
                Content="Reporting"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="8" />
            <Button
                x:Name="DiagnosticNavButton" Grid.Column="9" Click="TabNavigationBtn_OnClick"
                Content="System Diagnostics"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="9" />
            <Button
                x:Name="AlignmentNavButton" Grid.Column="10" Click="TabNavigationBtn_OnClick"
                Content="Alignment Check"
                Style="{StaticResource TabNavigationButtonStyle}"
                Tag="10" />
        </Grid>
        <!--#endregion-->
        <!--#region Navigation Frame-->
        <Frame
            x:Name="MainFrame" Grid.Row="2"
            Background="{StaticResource PageColor}"
            NavigationUIVisibility="Hidden" />
        <!--#endregion-->
        <!--#region Bottom Menu Bar-->
        <Border
            Grid.Row="3"
            Background="{StaticResource TopMenuColor}"
            BorderThickness="{StaticResource AllSmall}"
            Style="{StaticResource MenuBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Column="0"
                    BorderThickness="{StaticResource RightExtraSmall}"
                    Content="{Binding DataManager.CurrentDateString, ElementName=MainWindowRoot, Mode=OneWay}"
                    Style="{StaticResource BottomMenuLabelStyle}" />
                <Label
                    Grid.Column="1"
                    BorderThickness="{StaticResource SideExtraSmall}"
                    Content="{Binding DataManager.CurrentTimeString, ElementName=MainWindowRoot, Mode=OneWay}"
                    Style="{StaticResource BottomMenuLabelStyle}" />
                <Label
                    Grid.Column="2" BorderThickness="1,0,2,0"
                    Content="{Binding DataManager.IsPlcConnected, Converter={StaticResource ConnectionBoolToWordConverter}}"
                    Foreground="{StaticResource ContrastTextColor}"
                    Style="{StaticResource BottomMenuLabelStyle}" />
                <Label
                    Grid.Column="3" BorderThickness="1,0,2,0"
                    Content="{Binding DataManager.PlcStatusText, ElementName=MainWindowRoot, Mode=OneWay}"
                    Foreground="{StaticResource ContrastTextColor}"
                    Style="{StaticResource BottomMenuLabelStyle}" />
                <Border
                    Grid.Column="11" Grid.ColumnSpan="3"
                    Padding="{StaticResource AllSmall}"
                    HorizontalAlignment="Right">
                    <Image
                        Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Source="pack://application:,,,/Resources/Images/top_bar_logo.png" />
                </Border>
            </Grid>
        </Border>
        <!--#endregion-->
    </Grid>
</Window>
