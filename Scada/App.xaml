<Application
    x:Class="TimetTankSix.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:TimetTankSix.Converters" xmlns:local="clr-namespace:TimetTankSix" StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ColorResource.xaml" />
                <ResourceDictionary Source="/Resources/SizingResource.xaml" />
                <!--  ALWAYS LOAD STYLES AFTER CORE RESOURCES  -->
                <ResourceDictionary Source="/Styles/LayoutStyles.xaml" />
                <ResourceDictionary Source="/Styles/TextStyles.xaml" />
                <!--  THEN THE REST  -->
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Styles/MiscControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Converters  -->
            <!--  Bools  -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:ConnectionBoolToWordConverter x:Key="ConnectionBoolToWordConverter" />
            <!--  Double  -->
            <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
            <converters:DoubleToVisibilityConverter x:Key="DoubleToVisibilityConverter" />
            <!--  Colors  -->
            <converters:DarkenColorConverter x:Key="DarkenColorConverter" />
            <converters:GaugeColorConverter x:Key="GaugeColorConverter" />
            <!--  Math  -->
            <converters:MultiplicationConverter x:Key="MultiplicationConverter" />
            <converters:NormalizedPositionConverter x:Key="NormalizedPositionConverter" />
            <converters:ThresholdPositionConverter x:Key="ThresholdPositionConverter" />
            <converters:ThresholdVisibilityConverter x:Key="ThresholdVisibilityConverter" />
            <converters:ValueToPositionConverter x:Key="ValueToPositionConverter" />
            <!--  Strings  -->
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
